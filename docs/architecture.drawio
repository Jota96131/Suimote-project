        <mxCell id="github_actions_sub" value="&lt;font style=&quot;font-size:9px;color:#999&quot;&gt;lint → test → build → deploy&lt;/font&gt;" style="text;html=1;align=center;fontSize=9;" vertex="1" parent="1">
