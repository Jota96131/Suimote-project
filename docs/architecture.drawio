<mxfile>
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ユーザー -->
        <mxCell id="user_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;strokeWidth=2;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="user_label" value="ユーザー" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="485" y="35" width="80" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="user_phone" value="📱" style="text;html=1;align=center;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="user_pc" value="💻" style="text;html=1;align=center;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="530" y="60" width="40" height="40" as="geometry"/>
        </mxCell>

        <!-- ユーザー → Firebase Hosting 矢印 -->
        <mxCell id="arrow_user_hosting" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#666666;fontSize=11;fontColor=#666666;" edge="1" parent="1" source="user_box" target="hosting_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CI/CD ゾーン -->
        <mxCell id="cicd_zone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="280" height="100" as="geometry"/>
