        <mxCell id="cicd_label" value="CI/CD" style="text;html=1;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#7B61FF;" vertex="1" parent="1">
          <mxGeometry x="210" y="195" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="developer" value="👨‍💻&lt;br&gt;Developer" style="text;html=1;align=center;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
